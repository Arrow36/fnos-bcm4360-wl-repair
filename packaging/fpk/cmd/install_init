#!/bin/bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/bcm4360-wl-repair-install.log}"

fail() {
    printf '%s\n' "$*" >>"$LOG_FILE"
    exit 1
}

[[ "$(uname -m)" == "x86_64" || "$(uname -m)" == "amd64" ]] ||
    fail "此应用只支持 x86_64/amd64 系统。"

command -v lspci >/dev/null 2>&1 ||
    fail "系统缺少 lspci，无法识别网卡。"

lspci -Dn 2>/dev/null | grep -qi '14e4:43a0' ||
    fail "没有检测到 Broadcom BCM4360（PCI ID 14e4:43a0），已停止安装。"

for command_name in dkms dpkg-deb modinfo modprobe sha256sum; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "系统缺少必要命令：${command_name}"
done

[[ -e "/lib/modules/$(uname -r)/build" ]] ||
    fail "缺少当前内核头文件：/lib/modules/$(uname -r)/build。请先安装/恢复匹配的 fnOS 内核头文件。"

exit 0
