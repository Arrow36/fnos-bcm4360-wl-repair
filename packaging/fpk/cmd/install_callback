#!/bin/bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/bcm4360-wl-repair-install.log}"
APP_DIR="${TRIM_APPDEST:?TRIM_APPDEST 未设置}"
INSTALLER="${APP_DIR}/bin/fnos-bcm4360-oneclick.sh"
DRIVER_PACKAGE="${APP_DIR}/packages/broadcom-sta-dkms_6.30.223.271-30_amd64.deb"

if ! /bin/bash "$INSTALLER" install --deb "$DRIVER_PACKAGE" >>"$LOG_FILE" 2>&1; then
    printf '%s\n' "BCM4360 驱动安装失败；详细信息见安装日志。" >>"$LOG_FILE"
    exit 1
fi

exit 0
